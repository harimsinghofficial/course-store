# Copy this file to `.env` and fill it in. NEVER commit `.env`.
#
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)

# development  -> demo checkout allowed when Razorpay keys are empty, API docs enabled
# production   -> demo checkout disabled, strict cookies/HSTS, API docs disabled
APP_ENV=development

# Public URL of the site, no trailing slash. Used for canonical URLs, emails, sitemap.
BASE_URL=http://localhost:8000

# Long random string used to sign download links and admin sessions.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# REQUIRED in production. In development one is generated automatically.
SECRET_KEY=

# Comma-separated hostnames this site answers to (blocks Host-header attacks).
# Example: ALLOWED_HOSTS=learn.example.com,www.learn.example.com
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# --- Razorpay (https://dashboard.razorpay.com -> Settings -> API Keys) ---
# Leave these empty in development to use the built-in demo checkout.
# Start with TEST keys (rzp_test_...). Switch to LIVE keys (rzp_live_...) when KYC is done.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Settings -> Webhooks. Webhook URL: {BASE_URL}/api/webhooks/razorpay
# Events to enable: payment.captured, order.paid
RAZORPAY_WEBHOOK_SECRET=

# --- Admin dashboard (/admin) ---
# Generate a hash:  python -m library.security hash "your-strong-password"
ADMIN_PASSWORD_HASH=
# Development shortcut only (ignored in production):
ADMIN_PASSWORD=

# --- Email (optional): sends the "your access" email after payment ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Kiln <no-reply@example.com>

# --- Ad tracking (optional) ---
GA4_ID=
META_PIXEL_ID=
